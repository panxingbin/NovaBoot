# ============================================================
# NovaBoot Docker Compose 環境變量
# 用法：複製本文件為 .env 後按需修改—— cp .env.example .env
# 注意：.env 含真實密碼，且當前倉庫 .gitignore 尚未忽略 .env，提交前請先自行將其加入 .gitignore，切勿提交到倉庫
# ============================================================

# ---------- MySQL ----------
# root 密碼（必填）：用於 mysql:8.4 容器初始化，同時作為後端數據源連接密碼（MYSQL_PASSWORD）
# 生產環境請務必改成強密碼
MYSQL_ROOT_PASSWORD=change-me

# 業務庫名：容器啟動時自動創建，Flyway 會在其中執行版本化遷移（建表 + 種子數據）
MYSQL_DB=nova_boot

# ---------- Redis ----------
# 後端在 mysql profile 下會話/驗證碼/在線用戶存 Redis；compose 內默認用服務名 redis
REDIS_HOST=redis
REDIS_PORT=6379
# 注：compose 默認啟動的 redis 未啟用密碼認證；如需認證請自行擴展 command 與後端 REDIS_PASSWORD

# ---------- 對外端口 ----------
# 前端（nginx）對外端口；改為 8081 等可避免與本機 80 衝突
# 後端 API 固定映射 8080:8080（docker-compose.yml）
