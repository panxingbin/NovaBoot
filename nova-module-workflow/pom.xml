<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.novaboot</groupId>
        <artifactId>nova-boot</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>nova-module-workflow</artifactId>
    <name>NovaBoot :: Module :: Workflow</name>
    <description>M3 工作流：Flowable 流程引擎接入 + 可配置表單（請假單示例）</description>

    <dependencies>
        <dependency>
            <groupId>com.novaboot</groupId>
            <artifactId>nova-module-system</artifactId>
        </dependency>
        <!-- Flowable 8：僅在 mysql profile 啟用（H2 建表腳本不兼容，local profile 已排除其自動配置） -->
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-spring-boot-starter-process</artifactId>
            <version>8.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
