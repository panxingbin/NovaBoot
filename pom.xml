<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.novaboot</groupId>
    <artifactId>nova-boot</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>NovaBoot</name>
    <description>NovaBoot - 開源企業級 Web 應用基礎框架</description>

    <modules>
        <module>nova-dependencies</module>
        <module>nova-common</module>
        <module>nova-framework</module>
        <module>nova-module-system</module>
        <module>nova-module-generator</module>
        <module>nova-starter-ai</module>
        <module>nova-starter-mail</module>
        <module>nova-server-admin</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.novaboot</groupId>
                <artifactId>nova-dependencies</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
